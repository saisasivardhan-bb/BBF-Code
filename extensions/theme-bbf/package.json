      {
        "id": "BBF Light",
        "label": "%bbfLightThemeLabel%",
        "uiTheme": "vs",
        "path": "./themes/bbf-light-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blackboxfactories/bbf-code.git"
  }
}
