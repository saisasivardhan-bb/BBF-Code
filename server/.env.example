# Repository holding the releases that carry the .vsix assets
GITHUB_REPO=blackboxfactories/bbf-extensions

# Fine-grained PAT with "Contents: Read" on that repository.
# Never leaves this server; BBF Code talks to this server, not GitHub.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Shared secret BBF Code sends as: Authorization: Bearer <token>
# Leave empty to run the feed open (only sensible on a private network).
BBF_API_TOKEN=

# Public base URL, used to build download links in the feed
PUBLIC_URL=https://bbf-server-code.onrender.com/
PORT=4000

# How long release metadata is cached before GitHub is queried again
REFRESH_SECONDS=300

# --- BBF AI Coder ---------------------------------------------------------
# The company OpenCode Zen key. This is the single most sensitive value here:
# it is shared by everyone, so one leak affects everyone at once.
#
# It stays on this server. BBF Code never receives it -- clients exchange their
# Google sign-in for a short-lived session token and reach Zen through this
# server's /ai-coder/zen/v1 proxy. Never paste it into settings.json, an
# extension, a screenshot, or a terminal.
ZEN_API_KEY=

# Google Workspace domain allowed to use AI Coder. Checked against the `hd`
# claim of the caller's Google identity, so personal Gmail accounts are refused.
GOOGLE_ALLOWED_DOMAIN=blackboxfactories.com

# How long an issued AI session token is valid (default 12 hours). Clients
# re-exchange silently when it expires.
AI_SESSION_TTL_SECONDS=43200
